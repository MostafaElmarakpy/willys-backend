{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "docker-compose exec willys-backend npx ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migrate": "npm run typeorm migration:run -- -d src/database/typeorm.config.ts",
    "seed": "docker-compose exec willys-backend npx ts-node -r tsconfig-paths/register src/database/seeders/run-seeders.ts",
    "typeorm:prod": "npx ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migrate:prod": "npm run typeorm:prod migration:run -- -d dist/database/typeorm.config.js",
    "seed:prod": "node dist/database/seeders/run-seeders.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.616.0",
    "@elastic/elasticsearch": "^8.17.1",
    "@faker-js/faker": "^9.5.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/cache-manager": "^3.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/elasticsearch": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/serve-static": "^5.0.2",
    "@nestjs/swagger": "^11.0.3",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/hpp": "^0.2.6",
    "@types/multer": "^1.4.12",
    "axios": "^1.8.4",
